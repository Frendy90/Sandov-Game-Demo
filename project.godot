; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sandov"
config/version="0.1 [Tested]"
run/main_scene="res://World/Menu.tscn"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

GlobalVar="*res://Global_var.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/initial_position_type=0
window/energy_saving/keep_screen_on=false
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="Sandov"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input]

Right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
]
}
Left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
]
}
Jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Unblocked"
2d_physics/layer_3="Block"
2d_physics/layer_4="Wallpaper"

[physics]

2d/time_before_sleep=0.2
common/enable_pause_aware_picking=true
2d/bp_hash_table_size=2048
2d/cell_size=8
2d/large_object_surface_threshold_in_cells=64

[rendering]

textures/vram_compression/import_etc2_astc=true
limits/time/time_rollover_secs=2200.0
environment/defaults/default_clear_color=Color(0, 0.0069616702, 0.006841358, 1)
environment/defaults/default_environment="res://default_env.tres"
quality/driver/driver_name="GLES2"
2d/options/use_nvidia_rect_flicker_workaround=true
2d/snapping/use_gpu_pixel_snap=true
threads/thread_safe_bvh=true
vram_compression/import_etc=true
quality/reflections/high_quality_ggx=false
gles2/compatibility/disable_half_float=true
portals/pvs/use_simple_pvs=true
limits/buffers/canvas_polygon_buffer_size_kb=64
cpu_lightmapper/quality/low_quality_ray_count=32
cpu_lightmapper/quality/medium_quality_ray_count=128
cpu_lightmapper/quality/high_quality_ray_count=256
quality/depth/use_32_bpc_depth=true

[world]

2d/cell_size=8
